diff --git a/src/core/OpenGL_3D.cpp b/src/core/OpenGL_3D.cpp
index 48a1ac1..f5c6e63 100644
--- a/src/core/OpenGL_3D.cpp
+++ b/src/core/OpenGL_3D.cpp
@@ -229,9 +229,16 @@ void OpenGL_3D::ConstructWindow(int width, int height, std::string windowName)
 	if (!glfwInit())
 		Error("glfwInit failed");
 
+#ifdef __EMSCRIPTEN__
+	// WebGL2 == GLES 3.0. A "3.3 core" request has no meaning in the browser.
+	glfwWindowHint(GLFW_CLIENT_API, GLFW_OPENGL_ES_API);
+	glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
+	glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 0);
+#else
 	glfwWindowHint(GLFW_CONTEXT_VERSION_MAJOR, 3);
 	glfwWindowHint(GLFW_CONTEXT_VERSION_MINOR, 3);
 	glfwWindowHint(GLFW_OPENGL_PROFILE, GLFW_OPENGL_CORE_PROFILE);
+#endif
 
 	// Make the window non-resizable
 	glfwWindowHint(GLFW_RESIZABLE, GL_FALSE);
@@ -254,11 +261,15 @@ void OpenGL_3D::ConstructWindow(int width, int height, std::string windowName)
 
 	// Disable V-Sync (to achieve 60+ fps)
 	// Comment this out to get 60 fps (max)
+#ifndef __EMSCRIPTEN__
+	// Web: frame pacing is requestAnimationFrame (set by emscripten_set_main_loop);
+	// calling this before the main loop exists only logs a warning.
 	glfwSwapInterval(0);
 
-	// Load all function pointers using GLAD
+	// Load all function pointers using GLAD. Web links WebGL2 directly, nothing to load.
 	if (!gladLoadGLLoader((GLADloadproc)glfwGetProcAddress))
 		Error("Failed to initialize GLAD");
+#endif
 
 	// Set viewport and callback function when window gets resized 
 	glViewport(0, 0, m_width, m_height);
@@ -268,7 +279,11 @@ void OpenGL_3D::ConstructWindow(int width, int height, std::string windowName)
 	glDepthFunc(GL_LESS);
 
 	// Enable multi-sampling (usually enabled, good to enable it ourselves anyways)
+#ifndef __EMSCRIPTEN__
+	// Not a GLES/WebGL2 enum (GL_INVALID_ENUM). On web MSAA is the canvas `antialias`
+	// attribute, which GLFW_SAMPLES above already requests.
 	glEnable(GL_MULTISAMPLE);
+#endif
 
 	// Make the image loading library flip textures on load by default since 
 	// OpenGL's texture coordinate system has the y-axis going 
diff --git a/src/rendering/Shader.cpp b/src/rendering/Shader.cpp
index b0bded5..fab8425 100644
--- a/src/rendering/Shader.cpp
+++ b/src/rendering/Shader.cpp
@@ -56,8 +56,18 @@ void Shader::load(const std::string& shaderPath)
 	unsigned int fs = CompileShader(GL_FRAGMENT_SHADER, fragmentShader, shaderPath);
 	unsigned int gs;
 
+#ifdef __EMSCRIPTEN__
+	// GLES 3.0 / WebGL2 has no geometry stage. No shader uses one today; fail loudly
+	// if one is added instead of rendering garbage.
+	if (isGeometryShaderPresent)
+	{
+		std::cerr << "[OpenGL Error] geometry shaders unsupported on web: " << shaderPath << std::endl;
+		isGeometryShaderPresent = false;
+	}
+#else
 	if (isGeometryShaderPresent)
 		gs = CompileShader(GL_GEOMETRY_SHADER, geometryShader, shaderPath);
+#endif
 
 	// Link shaders
 	m_id = glCreateProgram();
@@ -236,8 +246,10 @@ unsigned int Shader::CompileShader(unsigned int type, const std::string& source,
 			std::cerr << "vertex";
 		else if (type == GL_FRAGMENT_SHADER)
 			std::cerr << "fragment";
+#ifndef __EMSCRIPTEN__
 		else if (type == GL_GEOMETRY_SHADER)
 			std::cerr << "geometry";
+#endif
 
 		std::cerr << " shader in \'" << shaderPath << "\'" << std::endl;
 		std::cerr << "Log: " << message << std::endl;
